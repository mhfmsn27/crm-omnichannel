# 1. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# 2. Build Outputs
dist/
dist-ssr/
frontend/dist/
build/

# 3. Environment Secrets (CRITICAL)
.env
.env.*
!.env.example
*.local
*.env
*.pem
*.key
*service-account*.json
*firebase*.json

# 4. User Media & Database Dumps
backend/uploads/*
!backend/uploads/.gitkeep
backend/logs/*
!backend/logs/.gitkeep
crmhub_backup*.sql
*.dump
*.sql.gz
!backend/migrations/*.sql
!db sql/*.sql

# 5. WhatsApp Sessions
backend/sessions/*
!backend/sessions/.gitkeep
auth_info_baileys/
.wwebjs_auth/

# 6. Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. OS & IDE Metadata
.DS_Store
Thumbs.db
