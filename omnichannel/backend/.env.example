# ==========================================
# CRMHUB BACKEND - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your values
# ==========================================

PORT=8998
NODE_ENV=production
APP_URL=http://localhost:8998

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/crmhub_db

# Redis Cache & BullMQ Queues
REDIS_URL=redis://localhost:6379

# Security & JWT Token
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here

# WhatsApp Gateway Connection
WA_GATEWAY_URL=http://localhost:8000
WA_GATEWAY_API_KEY=your_wa_gateway_api_key_here

# Meta / Instagram / Messenger API (Optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MESSENGER_APP_ID=
MESSENGER_SECRET=
MESSENGER_API_VERSION=v24.0
INSTAGRAM_APP_ID=
INSTAGRAM_SECRET=
INSTAGRAM_API_VERSION=v24.0

# Telegram Bot API (Optional)
TELEGRAM_BOT_TOKEN=

# DOKU Payment Gateway (Optional)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# Firebase Push Notification (Optional)
FIREBASE_SERVICE_ACCOUNT=

# Google Gemini AI API Key (Optional)
GEMINI_API_KEY=
